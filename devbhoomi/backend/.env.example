NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGO_URI=your_mongodb_connection_string

JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_PROVIDER_API_KEY=your_otp_provider_key

# Message Central "Verify Now" — phone number OTP verification on Signup
# (see backend/src/utils/messageCentral.js). Get these from your Message
# Central dashboard at console.messagecentral.com. Leave
# MESSAGE_CENTRAL_CUSTOMER_ID blank to disable and fall back to the Brevo
# SMS path below instead.
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_EMAIL=
MESSAGE_CENTRAL_PASSWORD=

# Brevo Transactional SMS (separate from the Brevo SMTP block below — get
# this from Brevo dashboard > SMS Campaigns > API Keys). For Indian numbers
# this also requires a DLT-registered sender/template or delivery will
# silently fail even with a valid key. If left unset, OTP requests still
# work end-to-end via the "send by email instead" fallback.
BREVO_API_KEY=
BREVO_SMS_SENDER=DevBand

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP config
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Devbhoomi Bandhan <no-reply@devbhoomibandhan.com>"

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
